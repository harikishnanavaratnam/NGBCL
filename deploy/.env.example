# Copy to deploy/.env on the server (chmod 600). NEVER commit the real file.
# Generate secrets with:  openssl rand -base64 48

# ---- Hostnames ----
API_DOMAIN=ngbcl-api.duckdns.org           # the API (Caddy gets its certificate for this name)
ACME_EMAIL=you@example.com                 # Let's Encrypt expiry notices
SITE_URL=https://ngbcl.vercel.app          # the website on Vercel (no trailing slash)

# ---- Database ----
DB_PASSWORD=

# ---- API (Spring Boot reads these) ----
NGBCL_JWT_SECRET=
NGBCL_IP_HASH_SALT=
NGBCL_ALLOWED_ORIGINS=https://ngbcl.vercel.app
NGBCL_COOKIE_SECURE=true
NGBCL_API_DOCS_ENABLED=false

# Cloudflare R2 (same account as the uploads buckets)
NGBCL_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
NGBCL_STORAGE_ACCESS_KEY=
NGBCL_STORAGE_SECRET_KEY=
NGBCL_STORAGE_PRIVATE_BUCKET=ngbcl-private
NGBCL_STORAGE_PUBLIC_BUCKET=ngbcl-public
NGBCL_STORAGE_PUBLIC_BASE_URL=https://pub-<id>.r2.dev

# Cloudflare Turnstile (registration forms)
NGBCL_TURNSTILE_SECRET=
NGBCL_TURNSTILE_SITE_KEY=

# Tell the website to refresh cached pages after changes (same secret as Vercel's REVALIDATE_SECRET)
NGBCL_SITE_REVALIDATE_URL=https://ngbcl.vercel.app/api/revalidate
NGBCL_SITE_REVALIDATE_SECRET=

# First Super Administrator — used once on an empty database, then remove these two lines.
NGBCL_BOOTSTRAP_ADMIN_EMAIL=
NGBCL_BOOTSTRAP_ADMIN_PASSWORD=
NGBCL_BOOTSTRAP_ADMIN_NAME=Super Admin

API_MEMORY=2g

# ---- Backups (scripts/backup.sh) ----
# A separate private R2 bucket and an API token limited to it (Object Read & Write).
BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=ngbcl-backups
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=
# Encrypts every dump. Keep a copy OUTSIDE the server (password manager) — without it backups can't be restored.
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# ---- Alerts (healthchecks.io, free) ----
# One check per job; the server pings it, healthchecks.io emails you when a ping is late or reports failure.
HC_BACKUP_URL=https://hc-ping.com/<uuid>
HC_DISK_URL=https://hc-ping.com/<uuid>
DISK_ALERT_PERCENT=85

# ---- DuckDNS (scripts/duckdns.sh) ----
DUCKDNS_DOMAINS=ngbcl-api
DUCKDNS_TOKEN=
